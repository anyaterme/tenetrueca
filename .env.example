AUTH_PROVIDER=local
AUTH_API_URL=
AUTH_API_TOKEN=
AUTH_API_TIMEOUT=5
MAGIC_LOGIN_ENABLED=True
MAGIC_LOGIN_EXPIRATION_MINUTES=30
MAGIC_LOGIN_COOLDOWN_SECONDS=60
REGISTRATION_VERIFICATION_EXPIRATION_MINUTES=60
REGISTRATION_VERIFICATION_COOLDOWN_SECONDS=60
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT=5
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@tenetrueca.com
EMAIL_SETTINGS_ENCRYPTION_KEY=

# disabled | mock | live. Mock mode is visibly labelled and never uses OpenAI.
OPENAI_EVALUATION_BACKEND=disabled
OPENAI_LIVE_ENABLED=False
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_SECONDS=45
AI_PREANALYSIS_TIMEOUT_SECONDS=60
AI_PREPARATION_TTL_HOURS=24
OPENAI_MAX_OUTPUT_TOKENS=2400
AI_IMAGE_MAX_DIMENSION=1024
AI_IMAGE_JPEG_QUALITY=80
AI_IMAGE_FORMAT=JPEG
AI_IMAGE_DETAIL=high
AI_IMAGE_REMOVE_EXIF=True
AI_IMAGE_MAX_COUNT=3
OPENAI_IMAGE_TOKEN_RESERVE=8192
OPENAI_MAX_ATTEMPTS=2
OPENAI_RETRY_DELAY_SECONDS=120
OPENAI_DAILY_REQUEST_LIMIT=20
OPENAI_DAILY_BUDGET_USD=1
# Optional lifetime cap across all local usage history; requires PostgreSQL. Blank disables it.
OPENAI_TOTAL_BUDGET_USD=
OPENAI_REQUEST_RESERVE_USD=0.10
# Set current rates for the chosen model before enabling live calls.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
OPENAI_MAX_INPUT_BYTES=30000

# Conversational assistant: set CHATBOT_PROVIDER=openai explicitly in production.
CHATBOT_ENABLED=True
CHATBOT_ANONYMOUS_LIMIT=10
CHATBOT_MAX_INPUT_CHARS=2000
CHATBOT_HISTORY_MESSAGES=10
CHATBOT_CONTEXT_TURNS=4
CHATBOT_PROVIDER=mock
# Opt in after staging evaluation; extractive is the immediate rollback.
CHATBOT_GENERATION_MODE=natural
CHATBOT_OPENAI_MODEL=gpt-6-luna
CHATBOT_MAX_OUTPUT_TOKENS=400
CHATBOT_REQUEST_TIMEOUT=30
CHATBOT_REASONING_EFFORT=none
CHATBOT_RATE_LIMIT_REQUESTS=6
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60

# History cleanup is manual/scheduled only; deployment never deletes history.
CHATBOT_RETENTION_DAYS=30

# Local retrieval only; it does not enable or change OpenAI requests.
CHATBOT_KNOWLEDGE_MAX_FRAGMENTS=5
CHATBOT_KNOWLEDGE_FRAGMENT_CHARS=1200
CHATBOT_KNOWLEDGE_CONTEXT_CHARS=6000

# Disabled evaluation pilot: configure a single persistent authorization UUID in staging.
CHATBOT_EVAL_ALLOW_LIVE=False
CHATBOT_EVAL_ENVIRONMENT=disabled
CHATBOT_EVAL_AUTHORIZATION_ID=
CHATBOT_EVAL_CASE_IDS=
CHATBOT_EVAL_PROJECT_REF=
CHATBOT_EVAL_PRICING_FILE=
CHATBOT_EVAL_MAX_BUDGET_USD=1.00
CHATBOT_EVAL_MAX_REQUESTS=20
CHATBOT_EVAL_MAX_INPUT_TOKENS=1050000
CHATBOT_EVAL_MAX_OUTPUT_TOKENS=400
CHATBOT_EVAL_PRICE_MAX_AGE_DAYS=7
# conservative | auto (currently falls back to conservative) | verified (fails closed).
CHATBOT_EVAL_TOKEN_BOUND_METHOD=conservative
