# disabled | mock | live. Mock mode is visibly labelled and never uses OpenAI.
OPENAI_EVALUATION_BACKEND=disabled
OPENAI_LIVE_ENABLED=False
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=2400
AI_IMAGE_MAX_DIMENSION=1024
AI_IMAGE_JPEG_QUALITY=80
AI_IMAGE_FORMAT=JPEG
AI_IMAGE_DETAIL=high
AI_IMAGE_REMOVE_EXIF=True
AI_IMAGE_MAX_COUNT=3
OPENAI_IMAGE_TOKEN_RESERVE=8192
OPENAI_MAX_ATTEMPTS=2
OPENAI_RETRY_DELAY_SECONDS=120
OPENAI_DAILY_REQUEST_LIMIT=20
OPENAI_DAILY_BUDGET_USD=1
OPENAI_REQUEST_RESERVE_USD=0.10
