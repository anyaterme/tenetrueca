# Ubuntu VPS target: linux/amd64. Standalone Compose only. Never copy the operational .env.
# Final candidate, PostgreSQL and proxy use reviewed digests; no credentials here.
# Build-only runtime may use a local alias after recording its image ID.
TRUECA_CANDIDATE_RUNTIME_IMAGE=
TRUECA_STAGING_POSTGRES_IMAGE=
TRUECA_STAGING_PROXY_IMAGE=
TRUECA_CANDIDATE_IMAGE=
TRUECA_STAGING_HTTP_PORT=8083
# Absolute paths to NEW files in a private directory outside the checkout/build context.
TRUECA_STAGING_SECRET_KEY_FILE=
TRUECA_STAGING_DB_PASSWORD_FILE=
