TRUECA_PILOT_CASE_IDS=
TRUECA_PILOT_MAX_REQUESTS=20
TRUECA_PILOT_MAX_BUDGET_USD=1.00
TRUECA_PILOT_PROJECT_REF=
TRUECA_PILOT_API_KEY_FILE=
TRUECA_PILOT_PRICING_FILE=
